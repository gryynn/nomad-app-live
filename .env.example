# =============================================================================
# NOMAD — example environment configuration
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# Two profiles to choose from below: PRIVATE (your own infra) and OSS DEFAULT
# (the simplest setup for self-hosting).
# =============================================================================

# -----------------------------------------------------------------------------
# Storage backend  (where audio files are stored)
# -----------------------------------------------------------------------------
# Choose one driver:
#   local      — files stored on the local filesystem (./data/audio/)
#                Best for OSS users who want zero external dependency.
#   nextcloud  — WebDAV upload to a Nextcloud instance.
#                Best when you already self-host Nextcloud.
#   supabase   — Supabase Storage bucket (legacy default).
#                Required if you use the live-recording mode (chunks) until V1.
STORAGE_DRIVER=local

# Public URL of THIS backend, used to construct audio URLs that external
# transcription services (Groq, Deepgram) can reach. Required when
# STORAGE_DRIVER != "supabase".
PUBLIC_BACKEND_URL=https://nomad-api.mgdesign.cloud

# --- driver=local
# Path where audio files are stored (must be writable by the backend process).
# In Docker, mount a host volume to this path.
STORAGE_LOCAL_PATH=./data/audio

# --- driver=nextcloud
# Generate the password as a Nextcloud "app password" (Settings > Security)
# so it can be revoked individually and bypasses 2FA cleanly.
NEXTCLOUD_URL=https://your-nextcloud.tld
NEXTCLOUD_USER=your_login
NEXTCLOUD_PASSWORD=your_app_password
NEXTCLOUD_BASE_PATH=nomad-audio

# -----------------------------------------------------------------------------
# Database (Supabase REST API — required for V1)
# -----------------------------------------------------------------------------
# In V1 the backend only knows how to talk to a Supabase project (REST + RLS).
# OSS users must create a free project at supabase.com and paste the values.
# Future V2 will add a "local Postgres" mode (DATABASE_URL=postgres://...).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key
SUPABASE_ANON_KEY=your_anon_key
# Required so the backend can verify Supabase access tokens issued to mobile clients.
# Find it in Supabase > Project Settings > API > JWT Settings > JWT Secret.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Two paths supported and can coexist:
#  (a) Supabase Auth — email/password + magic link (no extra config needed
#      beyond the SUPABASE_* values above). For the magic link to deep-link
#      into the mobile app, whitelist `nomad://login-callback` in your
#      Supabase dashboard > Authentication > URL Configuration > Redirect URLs.
#  (b) OIDC (PocketID, Keycloak, Authelia, ...) — fill in the values below.
OIDC_ISSUER_URL=https://your-pocket-id-instance.tld
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
OIDC_REDIRECT_URI=https://your-nomad-domain.tld/api/auth/callback
APP_JWT_SECRET=generate_a_random_64_char_hex_secret
APP_FRONTEND_URL=https://your-nomad-domain.tld

# -----------------------------------------------------------------------------
# Audio access tokens (signed URLs for /api/audio/{id})
# -----------------------------------------------------------------------------
# Set AUDIO_TOKEN_REQUIRED=true to force every audio download to carry a
# short-lived JWT — recommended for production. When false, /api/audio/{id}
# falls back to "security through obscurity" (UUID hard to guess but public).
AUDIO_TOKEN_REQUIRED=false
AUDIO_TOKEN_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# Sign-up allowlist
# -----------------------------------------------------------------------------
# Self-hosted NOMAD should NOT let random people create accounts (they'd burn
# your disk + transcription quota). Recommended setup:
#   1. Supabase Dashboard → Authentication → Providers → Email:
#      set "Enable Signups" to OFF.
#   2. List below who's allowed via /api/signup. Comma-separated; each entry
#      is either an exact email or "@domain". Case-insensitive. Empty = no
#      one can sign up (set SIGNUP_OPEN=true for public demos).
# Example: SIGNUP_ALLOWLIST="me@example.com,@my-company.com,friend@other.org"
SIGNUP_ALLOWLIST=
SIGNUP_OPEN=false

# -----------------------------------------------------------------------------
# Transcription engines (BYOK — bring your own keys)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_key
DEEPGRAM_API_KEY=your_deepgram_key

# -----------------------------------------------------------------------------
# WYNONA (optional local GPU server for WhisperX)
# -----------------------------------------------------------------------------
WYNONA_HOST=
WYNONA_WOL_MAC=

# -----------------------------------------------------------------------------
# Frontend (build args; production passes these to the Vite build)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8400
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# -----------------------------------------------------------------------------
# Traefik routing (consumed by docker-compose.yml)
# -----------------------------------------------------------------------------
# Hostname for the PWA (frontend service). Defaults to nomad.localhost.
NOMAD_FRONTEND_HOST=nomad.localhost
# Hostname for the backend API (used by the frontend at runtime).
NOMAD_API_HOST=nomad-api.localhost
# Which Traefik entrypoint to bind to. Common values:
#   web        — plain HTTP, port 80
#   websecure  — HTTPS, port 443 (requires a Traefik cert resolver)
NOMAD_TRAEFIK_ENTRYPOINT=web
# Set "true" if your entrypoint terminates TLS; "false" for plain HTTP.
NOMAD_TRAEFIK_TLS=false
