# =============================================================================
# NOMAD — example environment configuration
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# Two profiles to choose from below: PRIVATE (your own infra) and OSS DEFAULT
# (the simplest setup for self-hosting).
# =============================================================================

# -----------------------------------------------------------------------------
# Storage backend  (where audio files are stored)
# -----------------------------------------------------------------------------
# Choose one driver:
#   local      — files stored on the local filesystem (./data/audio/)
#                Best for OSS users who want zero external dependency.
#   nextcloud  — WebDAV upload to a Nextcloud instance.
#                Best when you already self-host Nextcloud.
#   supabase   — Supabase Storage bucket (legacy default).
#                Required if you use the live-recording mode (chunks) until V1.
STORAGE_DRIVER=local

# Public URL of THIS backend, used to construct audio URLs that external
# transcription services (Groq, Deepgram) can reach. Required when
# STORAGE_DRIVER != "supabase".
PUBLIC_BACKEND_URL=https://nomad-api.mgdesign.cloud

# --- driver=local
# Path where audio files are stored (must be writable by the backend process).
# In Docker, mount a host volume to this path.
STORAGE_LOCAL_PATH=./data/audio

# --- driver=nextcloud
# Generate the password as a Nextcloud "app password" (Settings > Security)
# so it can be revoked individually and bypasses 2FA cleanly.
NEXTCLOUD_URL=https://your-nextcloud.tld
NEXTCLOUD_USER=your_login
NEXTCLOUD_PASSWORD=your_app_password
NEXTCLOUD_BASE_PATH=nomad-audio

# -----------------------------------------------------------------------------
# Database (Supabase REST API — required for V1)
# -----------------------------------------------------------------------------
# In V1 the backend only knows how to talk to a Supabase project (REST + RLS).
# OSS users must create a free project at supabase.com and paste the values.
# Future V2 will add a "local Postgres" mode (DATABASE_URL=postgres://...).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key
SUPABASE_ANON_KEY=your_anon_key

# -----------------------------------------------------------------------------
# Authentication (PocketID OIDC)
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=https://your-pocket-id-instance.tld
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
OIDC_REDIRECT_URI=https://your-nomad-domain.tld/api/auth/callback
APP_JWT_SECRET=generate_a_random_64_char_hex_secret
APP_FRONTEND_URL=https://your-nomad-domain.tld

# -----------------------------------------------------------------------------
# Transcription engines (BYOK — bring your own keys)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_key
DEEPGRAM_API_KEY=your_deepgram_key

# -----------------------------------------------------------------------------
# WYNONA (optional local GPU server for WhisperX)
# -----------------------------------------------------------------------------
WYNONA_HOST=
WYNONA_WOL_MAC=

# -----------------------------------------------------------------------------
# Frontend (build args; production passes these to the Vite build)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8400
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
